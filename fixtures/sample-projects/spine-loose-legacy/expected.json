  "verification": {
    "unverified": false,
    "verified": 6,
    "unmatched": [],
    "ignored": [
      "mask (clipping → needs no region)"
    ],
    "sharedRegion": {
      "region": "shield",
      "slots": [
        "shieldA",
        "shieldB"
      ],
      "note": "shared across slots — NOT a collision"
    },
    "pathOverride": {
      "attachment": "sword",
      "region": "items/sword"
