# apps/web build-time config (Vite). Copy to .env.local to override. All optional — with none set, the
# app runs exactly as the free beta (Pro fix unlocked, no backend).
#
# LOCAL DEV against the Go backend in Docker on this PC (see memory: local-backend-deploy):
#   VITE_PRO_GATE=true · VITE_API_BASE=http://localhost:8088 (or http://100.114.253.114:8088 on the tailnet)
#   VITE_LICENSE_PUBKEY=<curl localhost:8088/v1/pubkey>
#   make a test license: cd apps/api && go run ./tools/devmint -db ~/assetdoctor/data/asset-doctor.db
#   verify the wiring:   node tools/verify/license-connect-run.mjs <DEV_KEY>

# Pro gate. Leave unset/false to keep the fix FREE. Set "true" to require a license entitlement.
VITE_PRO_GATE=false

# ed25519 PUBLIC key (base64) matching the backend's signing seed. From `apps/api`: go run ./tools/keygen
VITE_LICENSE_PUBKEY=

# Thin-backend origin (no trailing slash), e.g. https://asset-doctor-api.fly.dev
VITE_API_BASE=

# Optional Stripe Checkout / Payment Link shown as "Get a license".
VITE_CHECKOUT_URL=
