# Asset Doctor thin backend — copy to .env for local dev (dev synthesizes an ephemeral signing key if
# LICENSE_SIGNING_SEED is unset, so the minimum to run is nothing). Production REQUIRES the secrets.

ENV=development
ADDR=:8080
DB_PATH=asset-doctor.db
ENTITLEMENT_TTL_DAYS=7

# CORS: comma-separated app origins allowed to call /v1/*. Dev defaults to "*". Prod MUST set this.
ALLOWED_ORIGINS=http://localhost:5173

# Rate-limit IP source. Empty = key on the raw TCP peer (correct for local/dev). Behind a trusted
# proxy, set to the header it injects with the real client IP (Fly.io: "Fly-Client-IP"). Do NOT set
# this to a header the client can forge through your proxy (e.g. plain X-Forwarded-For).
TRUSTED_IP_HEADER=

# License signing — generate with: go run ./tools/keygen
# LICENSE_SIGNING_SEED is the SERVER SECRET (base64, 32-byte seed). Never commit. Prod: fly secrets set.
LICENSE_SIGNING_SEED=

# Stripe — get the webhook secret from the Stripe dashboard / `stripe listen`. Prod: required.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# Opt-in metric history endpoint (privacy: off by default).
HISTORY_ENABLED=false
