{
  "manifest_version": 3,
  "name": "Asset Doctor — Runtime Profiler",
  "version": "0.1.0",
  "description": "Live GPU-workload HUD for HTML5/WebGL games (PixiJS/Phaser): draw calls, redundant binds, VRAM, hitches.",
  "minimum_chrome_version": "111",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Asset Doctor runtime profiler"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false,
      "js": ["inject.js"]
    }
  ]
}
