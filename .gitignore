# deps
node_modules/

# build
dist/
build/
*.tsbuildinfo

# vite
.vite/

# self-hosted Pixi KTX2 transcoder — REGENERATED from the installed pixi.js by
# apps/web/scripts/copy-ktx-transcoder.mjs (predev/prebuild), so it never drifts from the pinned
# version and we don't commit ~930 KB of vendored binary (round15 no-CDN KTX2 probe).
apps/web/public/transcoders/ktx/

# test
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# claude code local settings (personal, not shared)
.claude/settings.local.json

# verification screenshots (regenerable)
tools/verify/out/

# calibration reports (may contain proprietary asset names/sizes)
tools/calibrate/out/

# local calibration assets (proprietary — NOT for the public repo)
/assets/
/raw/
**/__MACOSX/

# secrets & local env (keep .env.example, ignore real ones)
.env
.env.local
.env.*.local

# apps/api (Go) runtime artifacts — SQLite db + compiled binary (never commit)
apps/api/*.db
apps/api/*.db-shm
apps/api/*.db-wal
apps/api/api
