{
  "name": "asset-doctor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @asset-doctor/web dev",
    "build": "pnpm --filter @asset-doctor/web build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "globals": "^15",
    "pngjs": "^7",
    "prettier": "^3",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
